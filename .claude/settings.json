{
  "permissions": {
    "allow": [
      "Bash(git push origin issue-*)",
      "Bash(git push -u origin issue-*)",
      "Bash(git push origin pr-assets*)",
      "Bash(git pull*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
