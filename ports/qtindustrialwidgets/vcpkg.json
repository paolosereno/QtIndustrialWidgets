{
  "name": "qtindustrialwidgets",
  "version": "2.5.1",
  "description": "A C++17 widget library for Qt Widgets with 12 instrumentation widgets for test benches, SCADA and telemetry applications",
  "homepage": "https://github.com/paolosereno/QtIndustrialWidgets",
  "license": "MIT",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
